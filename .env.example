# WedPlan Server — environment template (commit this file)
# Copy to .env and fill in real values. Never commit .env.

# --- MongoDB (Atlas) ---
# Atlas template format (placeholders filled from DB_USER/DB_PASSWORD):
#   mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/dbname
# A full credential-bearing URI or a bare URI also works.
DB_URI=
DB_USER=
DB_PASSWORD=
DB_NAME=WedPlan

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be a long random string and MUST differ from GOOGLE_CLIENT_SECRET.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend (CORS + trusted origin) ---
FRONTEND_URL=http://localhost:3000

# --- Optional ---
PORT=5000
STRIPE_SECRET_KEY=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
